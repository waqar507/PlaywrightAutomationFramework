# STAGING ENVIRONMENT CONFIGURATION
ENV_NAME=staging
BASE_URL=https://staging.example.com
API_BASE_URL=https://api-staging.example.com
DEFAULT_TIMEOUT=45000
EXPECT_TIMEOUT=12000
HEADLESS=true
LOG_LEVEL=INFO
ADMIN_USERNAME=staging_admin@example.com
ADMIN_PASSWORD=StagingSecretPassword123!
STANDARD_USERNAME=staging_user@example.com
STANDARD_PASSWORD=StagingUserPassword123!
FEATURE_EXPERIMENTAL_UI=false
