# QA ENVIRONMENT CONFIGURATION
ENV_NAME=qa
BASE_URL=https://qa.example.com
API_BASE_URL=https://api-qa.example.com
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
HEADLESS=true
LOG_LEVEL=INFO
